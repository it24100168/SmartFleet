# SmartFleet Backend Environment Variables

# PostgreSQL Connection String (e.g. Neon branch URL or local PostgreSQL)
# Format for ASP.NET Core environment variable overrides:
ConnectionStrings__DefaultConnection=Host=ep-xyz.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_SECRET_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# JWT Authentication Configuration
JwtSettings__Secret=SmartFleetSuperSecretKeyForJwtAuthentication2026!MustBeAtLeast32BytesLong
JwtSettings__Issuer=SmartFleetAPI
JwtSettings__Audience=SmartFleetClients
JwtSettings__ExpirationMinutes=1440

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
